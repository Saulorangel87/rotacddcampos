# Copie este arquivo pra .env (sem o .example) na VPS, do lado do
# docker-compose.yml, e preencha com valores reais. Esse .env NUNCA deve ir
# pro Git — já está coberto pela regra genérica ".env" no .gitignore.

# Senha do Postgres (só é usada dentro da rede interna do Docker, mas ainda
# assim escolha algo forte — não precisa ser a mesma senha do seu Postgres local)
DB_PASSWORD=troque-por-uma-senha-forte

# Gere um novo com: openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Domínio(s) reais que vão acessar a API — sem localhost em produção
CORS_ORIGINS=https://rotas.devsaulo.com.br

# URL pública da API, gravada dentro do build do frontend (Vite não lê isso
# em runtime — se mudar, precisa rodar "docker compose up -d --build" de novo)
VITE_API_URL=https://rotas-api.devsaulo.com.br
